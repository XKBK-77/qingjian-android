    <style name="KeyButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">1dp</item>
        <item name="android:background">@drawable/key_bg</item>
        <item name="android:textColor">@color/key_text</item>
        <item name="android:textSize">20sp</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:padding">0dp</item>
    </style>
    <style name="KeyButton.Function">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1.5</item>
        <item name="android:layout_margin">1dp</item>
        <item name="android:background">@drawable/key_bg_function</item>
        <item name="android:textColor">@color/key_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:padding">0dp</item>
    </style>
    <style name="KeyButton.Space">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">4</item>
        <item name="android:layout_margin">1dp</item>
        <item name="android:background">@drawable/key_bg</item>
        <item name="android:textColor">@color/key_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:padding">0dp</item>
    </style>
    <style name="Theme.QingjianIME" parent="android:Theme.Material.Light.NoActionBar"/>
</resources>